VITE_PUBLIC_BASE_PATH=/yuanji/
VITE_ANALYTICS_DAILY_FACT_V2=false
# 网页对话默认使用 AG-UI；紧急回退到旧接口时设置为 false 并重新构建。
VITE_AGUI_CHAT_ENABLED=true
WEB_SLOT_BIND=127.0.0.1
FRONTEND_BLUE_PORT=18080
FRONTEND_GREEN_PORT=18081

DEPLOY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
DEPLOY_BRANCH=main
DEPLOY_REPO_DIR=/opt/duizhangAgent-frontend
DEPLOY_SCRIPT=/opt/duizhangAgent-frontend/deploy/deploy.sh
DEPLOY_LOG_FILE=/var/log/duizhangAgent-frontend-deploy.log
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=9010
